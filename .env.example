# Порт и адрес HTTP-сервера
PORT=3000
HOST=0.0.0.0
# Путь к файлу SQLite (каталог создаётся автоматически)
DATABASE_PATH=./data/payments.db
# Часовой пояс учебного центра: от него зависят «текущий месяц» и «сегодня»
TZ_NAME=Europe/Moscow
LOG_LEVEL=info

# Логин и пароль администратора (HTTP Basic Auth на API, страницу и /docs).
# Пусто — доступ без пароля: только для локальной разработки.
ADMIN_USER=
ADMIN_PASSWORD=

# Telegram-бот (необязательно). Без токена бот не запускается, API и веб работают.
TELEGRAM_BOT_TOKEN=
# Telegram ID пользователей через запятую, которым разрешено пользоваться ботом.
# Пусто — бот отказывает всем и в ответ сообщает ID написавшего.
TELEGRAM_ALLOWED_USER_IDS=
# true — пускать в бота любого пользователя Telegram (только для проверки).
TELEGRAM_ALLOW_ALL=
